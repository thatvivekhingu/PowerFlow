# ─────────────────────────────────────────────────────────────────────────────
#  POWERFLOW MCP SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Server Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Database Connection (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/powerflow

# Fallback paths for local development and backtesting
FALLBACK_MOCK_DB_PATH=data/powerflow_2026_mock_db.json
FALLBACK_TELEMETRY_CSV=data/powerflow_2026_telemetry.csv

# DISCOM & Grid Constraints
DISCOM_NAME="PowerFlow Regional DISCOM"
DISCOM_WHEELING_RATE_INR_PER_KWH=0.25
MAX_UTILIZATION_BEFORE_CONGESTION_PCT=85.0
CRITICAL_UTILIZATION_LIMIT_PCT=95.0

# Dynamic Pricing Bounds (INR/kWh)
P_BASE_INR=5.0
P_MIN_INR=3.0
P_MAX_INR=8.0
PRICE_ALPHA=1.5
PRICE_BETA=1.0

# Order Limits
MIN_ORDER_KWH=0.1
MAX_ORDER_KWH=50.0

# Security & Audit
API_AUTH_TOKEN=pf-mcp-sec-token-2026
REQUIRE_AUTH=false
ENABLE_AUDIT_LOG=true
AUDIT_LOG_FILE=powerflow_mcp_audit.log

# ─────────────────────────────────────────────────────────────────────────────
#  POWERFLOW LANGGRAPH AGENT & LLM CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=groq/compound-mini

# Optional Local Ollama Fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
TEMPERATURE=0.1
MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=12.0

DEFAULT_FEEDER_ID=FEEDER-A
DEFAULT_METER_ID=H011
DEFAULT_USER_ID=H011
REQUIRE_TRADE_CONFIRMATION=true
MAX_TOOL_CALLS_PER_RUN=6
