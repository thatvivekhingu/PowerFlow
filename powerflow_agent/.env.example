# ─────────────────────────────────────────────────────────────────────────────
# POWERFLOW LANGGRAPH AGENT CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Agent Identity
AGENT_NAME=powerflow-agent
AGENT_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# LLM CONFIGURATION (Ollama local by default)
# ─────────────────────────────────────────────────────────────────────────────

# Provider: ollama, openai, anthropic
LLM_PROVIDER=ollama

# Ollama (Local LLM - Qwen 2.5 3B recommended for 8GB RAM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# OpenAI Compatible (Optional - for future use)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Compatible (Optional - for future use)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# ─────────────────────────────────────────────────────────────────────────────
# MCP SERVER CONNECTION
# ─────────────────────────────────────────────────────────────────────────────

# Transport: stdio (subprocess) or sse (HTTP)
MCP_TRANSPORT=stdio

# For stdio transport - command to start MCP server
MCP_SERVER_COMMAND=python -m powerflow_mcp.server --transport stdio

# For SSE transport - MCP server URL
# MCP_SSE_URL=http://localhost:8000/sse

# ─────────────────────────────────────────────────────────────────────────────
# POWERFLOW DOMAIN DEFAULTS
# ─────────────────────────────────────────────────────────────────────────────

DEFAULT_USER_ID=H011
DEFAULT_METER_ID=H011
DEFAULT_FEEDER_ID=FEEDER-A
DEFAULT_HORIZON_HOURS=24

# ─────────────────────────────────────────────────────────────────────────────
# SAFETY & ORDER LIMITS
# ─────────────────────────────────────────────────────────────────────────────

MAX_ORDER_KWH=50.0
MIN_ORDER_KWH=0.1
PRICE_FLOOR_INR=3.0
PRICE_CAP_INR=15.0
REQUIRE_CONFIRMATION_FOR_TRADES=true

# ─────────────────────────────────────────────────────────────────────────────
# LANGGRAPH EXECUTION
# ─────────────────────────────────────────────────────────────────────────────

MAX_ITERATIONS=10
RECURSION_LIMIT=50
ENABLE_TRACING=true

# ─────────────────────────────────────────────────────────────────────────────
# AUDIT & LOGGING
# ─────────────────────────────────────────────────────────────────────────────

ENABLE_AUDIT_LOG=true
AUDIT_LOG_FILE=powerflow_agent_audit.log